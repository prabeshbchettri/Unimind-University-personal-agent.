[TEMPLATE]
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.
# No real secrets belong in this example file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
# Browser origins allowed to call the API (comma-separated). The Vite dev
# server default is listed; tighten for real deployments.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Document ingestion
# ---------------------------------------------------------------------------
# Directory scanned for PDFs (relative paths are resolved from backend/)
DOCUMENTS_DIR=../data/documents
# Chunking is character-based with word-boundary packing.
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# "local" runs fastembed in-process (no server, downloads model on first use).
# "ollama" calls a local Ollama server.
EMBEDDING_PROVIDER=local
# Model for the "local" provider. The vector dimension below must match it.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Model for the "ollama" provider.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
# "local" runs Qdrant's embedded engine in-process, persisted to
# data/qdrant_storage (no server or Docker needed).
# To use a Qdrant server instead, set QDRANT_URL=http://localhost:6333.
QDRANT_URL=local
QDRANT_COLLECTION=university_docs

# ---------------------------------------------------------------------------
# LLM gateway (chat generation)
# ---------------------------------------------------------------------------
# "auto" (default): Groq primary, then Ollama fallback.
# "groq": Groq only. "ollama": Ollama only (no hosted provider needed).
LLM_PROVIDER=auto
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Primary hosted provider: Groq
# ---------------------------------------------------------------------------
# Required for LLM_PROVIDER=groq. With LLM_PROVIDER=auto, an empty value skips
# Groq and uses Ollama directly. Never commit a real key.
GROQ_API_KEY=
# Model must exist on Groq (see `GET /models`); the llama-3.x lineup was
# decommissioned there in 2026.
GROQ_MODEL=openai/gpt-oss-20b
# Change only to point at a Groq-compatible gateway.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Local provider (fallback): Ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Must be a model already installed in Ollama (`ollama list`).
# llama3.1 (8B) is the smallest locally tested model that produces reliable
# grounded answers with full-size contexts; 3B models degenerate on long prompts.
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Retrieval and context
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Chunks with similarity below this score are treated as insufficient evidence.
MIN_RELEVANCE_SCORE=0.45
# HYBRID strategy only: lexical-only chunks (found by BM25 but outside the
# vector top-k) pass the evidence gate when their BM25 score is at least this.
MIN_BM25_SCORE=1.0
MAX_CONTEXT_CHARS=4000
