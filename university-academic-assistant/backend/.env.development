# DEVELOPMENT environment template (backend/.env.development).
#
# Copy to .env (`cp .env.development .env`) or load via env vars.
# Everything points at local/offline services: no model server needed.

# --- General ---
APP_NAME=University Academic Assistant
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Backends (hermetic by default) ---
DATABASE_BACKEND=memory
GRAPH_BACKEND=memory
LLM_BACKEND=stub
EMBEDDER_BACKEND=deterministic
ROUTER_CLASSIFIER=rules
WEB_SEARCH_BACKEND=stub

# --- RAG ---
RAG_TOP_K=5
CONTEXT_MAX_CHARS=4000
CONTEXT_MAX_SOURCES=8
RAG_RETRIEVAL_STRATEGY=auto
HYBRID_RRF_K=60.0
HYBRID_RERANK_RRF_WEIGHT=0.7
HYBRID_RERANK_DENSE_WEIGHT=0.3
HYBRID_POOL_FACTOR=2

# --- Caching ---
EMBEDDING_CACHE_MAX_ENTRIES=5000
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_MAX_ENTRIES=256
RETRIEVAL_CACHE_TTL_SECONDS=300

# --- OCR ---
OCR_LANGUAGE=eng
OCR_DPI=300
PDF_ANALYZER_FORCE_METHOD=auto

# --- Structure extraction ---
STRUCTURE_EXTRACTOR=deterministic