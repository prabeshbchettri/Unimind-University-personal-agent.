# PRODUCTION environment template (backend/.env.production).
#
# Template ONLY — never commit real secrets. Every password/credential below
# is a placeholder that must be overridden in your deployment (env vars,
# secrets manager, or docker-compose interpolation). Example:
#
#   docker compose --profile llm up -d \
#     -e NEO4J_PASSWORD=<real> -e POSTGRES_PASSWORD=<real>
#   export LLM_BACKEND=ollama EMBEDDER_BACKEND=ollama
#
# docker-compose.yml in the repo root wires these same variables for the
# bundled services; set them once and everything lines up.

APP_NAME=University Academic Assistant
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated allowed browser origins (production frontend origin).
CORS_ORIGINS=https://assistant.example.com

# --- PostgreSQL (chat history) ---
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql+psycopg://assistant:CHANGE_ME_PG_PASSWORD@postgres:5432/academic_assistant

# --- Qdrant (vector store) ---
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=CHANGE_ME_QDRANT_KEY   # optional, when Qdrant auth is on

# --- Neo4j (knowledge graph) ---
GRAPH_BACKEND=auto
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# --- LLM + embeddings (Ollama, CPU-compatible) ---
LLM_BACKEND=ollama
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120.0
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDER_BACKEND=ollama
EMBEDDING_MODEL=bge-m3

# --- Router (rules needs no model; "llm" uses OLLAMA_MODEL) ---
ROUTER_CLASSIFIER=rules

# --- RAG ---
RAG_TOP_K=5
CONTEXT_MAX_CHARS=4000
CONTEXT_MAX_SOURCES=8
RAG_RETRIEVAL_STRATEGY=auto
HYBRID_RRF_K=60.0
HYBRID_RERANK_RRF_WEIGHT=0.7
HYBRID_RERANK_DENSE_WEIGHT=0.3
HYBRID_POOL_FACTOR=2

# --- Caching ---
EMBEDDING_CACHE_MAX_ENTRIES=5000
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_MAX_ENTRIES=256
RETRIEVAL_CACHE_TTL_SECONDS=300

# --- OCR (optional; leave empty to auto-detect tesseract) ---
TESSERACT_PATH=
OCR_LANGUAGE=eng
OCR_DPI=300
PDF_ANALYZER_FORCE_METHOD=auto

# --- Structure extraction ("deterministic" needs no LLM) ---
STRUCTURE_EXTRACTOR=deterministic