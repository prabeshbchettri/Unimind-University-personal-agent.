# ---- General ---------------------------------------------------------------
APP_NAME=University Academic Assistant
DEBUG=false

# ---- Logging ---------------------------------------------------------------
# text | json
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins allowed to call the API from the browser (React).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- PostgreSQL (Phase 10) -------------------------------------------------
# Chat history backend: memory | postgres | auto
#   memory   = in-process SQLite (tests / offline, no server needed)
#   postgres = PostgreSQL via DATABASE_URL below (requires: pip install psycopg[binary])
#   auto     = memory when DATABASE_URL is an in-memory sentinel, else postgres
DATABASE_BACKEND=memory
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/academic_assistant
# Bounded conversation history injected into the generation prompt.
HISTORY_MAX_CHARS=2000
HISTORY_MAX_MESSAGES=12
# Session titles derive from the first user message, truncated to this length.
SESSION_TITLE_MAX_CHARS=60

# ---- Qdrant (Phase 4) ------------------------------------------------------
# Use http://localhost:6333 for a running Qdrant server, or ":memory:" for an
# embedded in-memory client (no server; handy for offline development/tests).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Vector collection names (documents are routed by document type).
QDRANT_COLLECTION_UNIVERSITY_DOCS=university_docs
QDRANT_COLLECTION_PAST_QUESTIONS=past_questions
QDRANT_COLLECTION_LIBRARY_BOOKS=library_books

# ---- Neo4j / knowledge graph (Phase 7) --------------------------------------
# Graph backend: memory | neo4j | auto
#   memory = in-process in-memory graph (tests / offline, no server needed)
#   neo4j  = real Neo4j via NEO4J_URI (bolt)
#   auto   = memory when NEO4J_URI is an in-memory sentinel, else neo4j
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- LLM / Ollama (Phase 5) -----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Answer-generation backend: auto | ollama | stub
#   ollama = Llama 3.1 8B via Ollama /api/generate (uses OLLAMA_MODEL)
#   stub   = deterministic local fallback (tests / offline, no model needed)
#   auto   = ollama when OLLAMA_BASE_URL is set, else stub
LLM_BACKEND=auto
# Sampling temperature for grounded answers (low = faithful).
LLM_TEMPERATURE=0.2
# Timeout (seconds) for Ollama generation calls.
LLM_TIMEOUT=120

# ---- RAG (Phase 5) --------------------------------------------------------
# Retrieved chunks grounded into every answer.
RAG_TOP_K=5
# Max characters of retrieved context placed in the LLM prompt.
CONTEXT_MAX_CHARS=4000
# Max number of source chunks included in the LLM prompt.
CONTEXT_MAX_SOURCES=8
# Relevance floor for retrieval: chunks below this similarity are treated as
# no evidence (0.0 disables gating). Example: 0.0 disables, 0.01 drops
# zero-similarity matches with the deterministic embedder.
RAG_MIN_SCORE=0.0

# ---- Hybrid retrieval (Phase 6) + adaptive router (Phase 8) ---------------
# Retrieval strategy: auto | normal | hybrid
#   auto   = Query Analyzer + AdaptiveRouter decide per query (default)
#   normal = dense vector only (NormalRetriever) for every query
#   hybrid = dense vector + BM25 sparse, fused with Reciprocal Rank Fusion
RAG_RETRIEVAL_STRATEGY=auto
# Query classifier: rules | llm | auto
#   rules = deterministic rules only (explainable, no model needed)
#   llm   = rules first; LLM double-checks low-confidence verdicts
#   auto  = rules first; LLM consulted only when rules are inconclusive
ROUTER_CLASSIFIER=auto
# Strategy used when classification is uncertain: hybrid | normal
ROUTER_FALLBACK_STRATEGY=hybrid

# ---- Recommendation (Phase 9) -----------------------------------------------
# Minimum embedding cosine similarity for a semantic topic match (0..1).
# Names equal after normalization always match, regardless of this.
RECOMMENDATION_SEMANTIC_THRESHOLD=0.4
# Coverage formula: score = topic_weight * topic_coverage
#                            + subtopic_weight * subtopic_coverage
RECOMMENDATION_TOPIC_WEIGHT=0.85
RECOMMENDATION_SUBTOPIC_WEIGHT=0.15

# ---- Web search (Phase 11) ---------------------------------------------------
# Backend: stub | duckduckgo
#   stub       = deterministic canned results (tests / offline, no network)
#   duckduckgo = live DuckDuckGo HTML search via urllib (no API key;
#                WEB_SEARCH_TIMEOUT applies, results may be limited)
WEB_SEARCH_BACKEND=stub
# Per-request timeout (seconds) for live web search. A provider that exceeds
# it is treated as a search failure and the router falls back to internal
# retrieval instead of hanging the answer.
WEB_SEARCH_TIMEOUT=8
# Maximum number of web results included in the prompt and returned.
WEB_MAX_SOURCES=4
# RRF constant k in 1/(k + rank). Larger k compresses the rank advantage.
HYBRID_RRF_K=60
# Rerank blend: weight on the rank-based RRF score vs the dense similarity.
HYBRID_RERANK_RRF_WEIGHT=0.7
HYBRID_RERANK_DENSE_WEIGHT=0.3
# Candidate pool multiplier: each subsystem returns pool_factor * top_k
# results before fusion.
HYBRID_POOL_FACTOR=2

# ---- Embeddings (Phase 4) -------------------------------------------------
# Backend: auto | deterministic | ollama
#   deterministic = local token-hash vectors (tests / offline, no model needed)
#   ollama        = real embeddings via Ollama /api/embed (embedding model below)
#   auto          = ollama when OLLAMA_BASE_URL is set, else deterministic
EMBEDDER_BACKEND=auto
# Embedding model used by the vector index (separate from OLLAMA_MODEL).
# Pull with: ollama pull bge-m3
EMBEDDING_MODEL=bge-m3
# Dimensionality for the deterministic fallback (real backends infer theirs).
EMBEDDING_DIMENSIONS=384

# ---- Chunking (Phase 4) ----------------------------------------------------
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# ---- Ingestion / PDF (Phase 2) --------------------------------------------
# Leave TESSERACT_PATH empty to auto-detect (common locations / PATH).
TESSERACT_PATH=
OCR_LANGUAGE=eng
OCR_DPI=300
# PDF type detection heuristics.
PDF_ANALYZER_MIN_CHARS_PER_PAGE=20
PDF_ANALYZER_MIN_TEXT_RATIO=0.5
# auto | pymupdf | ocr
PDF_ANALYZER_FORCE_METHOD=auto
# Empty resolves to <project_root>/data/<name>.
DATA_RAW_DIR=
DATA_PROCESSED_DIR=

# ---- Structure extraction (Phase 3) ----------------------------------------
# deterministic | llm  (llm requires an LLM service, available from Phase 5)
STRUCTURE_EXTRACTOR=deterministic
# Extra university names (comma-separated) to detect, e.g. Purbanchal University
UNIVERSITY_NAMES=
# Minimum classification score before a document is labelled "unknown"
DOCUMENT_CLASSIFIER_MIN_SCORE=3
